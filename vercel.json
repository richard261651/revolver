{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/state", "dest": "/api/state.js" },
    { "src": "/api/admin/reset", "dest": "/api/admin/reset.js" },
    { "src": "/api/team/action", "dest": "/api/team/action.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
